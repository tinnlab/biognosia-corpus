# Copy to .env and fill in the values. .env is read by docker compose and by the scripts in scripts/.
# Placeholders only. Do not commit .env.

# ---- Paths -------------------------------------------------------------------
# All pipeline inputs and outputs are stored under DATA_DIR.
DATA_DIR=./data
# Hugging Face model cache (BGE-M3, MedCPT-Query-Encoder, potion-base-32M).
MODEL_CACHE_DIR=./data/models
# Database volumes of docker-compose.yml.
DATABASE_DIR=./database

# ---- Service credentials (docker-compose.yml) --------------------------------
NEO4J_PASSWORD=<set-a-neo4j-password>
MINIO_ACCESS_KEY=<set-a-minio-access-key>
MINIO_SECRET_KEY=<set-a-minio-secret-key>

# ---- Service sizing (optional) -----------------------------------------------
# NEO4J_HEAP_SIZE=8G
# NEO4J_PAGECACHE_SIZE=8G
# ES_HEAP_SIZE=8g
# REDIS_MAXMEMORY=16gb
# REDIS_CACHE_MAXMEMORY=16gb

# ---- Service endpoints (defaults match docker-compose.yml) ---------------------
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# REDIS_HOST=localhost
# REDIS_PORT=6379
# NGRAM_REDIS_HOST=localhost
# NGRAM_REDIS_PORT=6380
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j

# ---- External APIs ------------------------------------------------------------
# Semantic Scholar Graph API key (scripts/03_download_papers.sh).
SEMANTIC_SCHOLAR_API_KEY=<your-semantic-scholar-api-key>
# Optional contact address added to the User-Agent of API requests.
# CONTACT_EMAIL=<your-email>
# Hugging Face token (optional, raises the download rate limit).
# HF_TOKEN=<your-huggingface-token>

# ---- GPUs ---------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0
